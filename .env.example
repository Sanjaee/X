# Core Database & Cache
DATABASE_URL="postgresql://postgres:supersecretpassword30charslong123@postgres:5432/media_prod"
REDIS_URL="redis://:supersecretredispass@redis:6379"
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/"

# Database Credentials
DB_USER=postgres
DB_PASSWORD=supersecretpassword30charslong123
DB_NAME=media_prod
REDIS_PASSWORD=supersecretredispass

# Low-Memory VPS (4GB RAM) Resource & Concurrency Tuning
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
MAX_CONCURRENT_REQUESTS=300
RATE_LIMIT_PER_MIN=120
GOMEMLIMIT=300MiB
GOGC=80
NODE_OPTIONS="--max-old-space-size=384"

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost
NEXTAUTH_URL=http://localhost
BACKEND_URL=http://localhost/api
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Security & Secrets
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Payments & Monetization (Plisio Cryptocurrency Gateway)
PLISIO_API_KEY=""

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="lostmedia"
R2_ENDPOINT=""
R2_PUBLIC_DOMAIN=""
